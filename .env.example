# Локальный запуск без Docker. Скопируйте в .env и заполните своими значениями.
APP_ENV=local
LOG_LEVEL=INFO

# Postgres или SQLite для быстрой проверки:
# DATABASE_URL=sqlite+aiosqlite:///./payments.db
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments

# Без NATS сервис работает: события пишутся в лог.
# NATS_URL=nats://localhost:4222
EVENTS_SUBJECT=payments.succeeded

YOOKASSA_SHOP_ID=demo-shop
YOOKASSA_SECRET_KEY=demo-secret

# fake — чек-заглушка; nalog — реальный ЛК НПД (нужен пакет nalogovich).
FISCAL_MODE=fake
# FISCAL_INN=
# FISCAL_PASSWORD=
